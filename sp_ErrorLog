USE [C2A_ADMIN]
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

CREATE   PROCEDURE [dbo].[sp_ErrorLog]
	@blockName VARCHAR (255) = '',
	@userMessage VARCHAR (4000) = ''
WITH EXECUTE AS SELF
AS
BEGIN
	SET NOCOUNT ON;

	BEGIN TRY

		INSERT [dbo].[Etllog]
			(			
				[logLevel],
				[TaskName],
				[Message],
				[user]
 			) 
		VALUES 
			(
				'error',
				@blockName,
				'Error ' + ISNULL(CONVERT(varchar(50), ERROR_NUMBER()),'-') +
				', Severity ' + ISNULL(CONVERT(varchar(5), ERROR_SEVERITY()),'-') +
				', State ' + ISNULL(CONVERT(varchar(5), ERROR_STATE()),'-') + 
				', Procedure ' + ISNULL(ERROR_PROCEDURE(), '-') + 
				', Line ' + ISNULL(CONVERT(varchar(5), ERROR_LINE()),'-'),
				SYSTEM_USER -- true login of user doing something in DB
			);

	END TRY
	BEGIN CATCH
		EXECUTE [dbo].[sp_printError];
	END CATCH

END;
