CREATE   PROCEDURE [dbo].sp_printError
WITH EXECUTE AS SELF
AS
BEGIN
	SET NOCOUNT ON;

	-- Print error information. 
	PRINT 'Error ' + ISNULL(CONVERT(varchar(50), ERROR_NUMBER()),'-') +
		  ', Severity ' + ISNULL(CONVERT(varchar(5), ERROR_SEVERITY()),'-') +
		  ', State ' + ISNULL(CONVERT(varchar(5), ERROR_STATE()),'-') + 
		  ', Procedure ' + ISNULL(ERROR_PROCEDURE(), '-') + 
		  ', Line ' + ISNULL(CONVERT(varchar(5), ERROR_LINE()),'-');
	PRINT 'Error message: '+ ISNULL(ERROR_MESSAGE(),'-');
END;
